# Copy to .env.local (gitignored) and fill in. Never commit real values.

# --- Neon Postgres (neon.com — free tier, no card) ---------------------------
# Pooled connection string, used by the app at runtime.
# Format: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=
# Direct (non-pooled) connection, used by Drizzle migrations only.
# Same string with "-pooler" removed from the host.
DATABASE_URL_UNPOOLED=

# --- Gemini (aistudio.google.com — free tier, no card) -----------------------
GEMINI_API_KEY=

# Model IDs are configurable so a rate-limit change never means a code edit.
# gemini-2.5-flash is NOT usable: 404 "no longer available to new users".
# Reasoning tokens dominate cost here — always send thinkingLevel: low for
# extraction and classification. Measured 654 -> 158 tokens, identical output.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Cuts pgvector storage 4x vs. the 3072 default. Vectors at this size are NOT
# returned pre-normalized — we normalize client-side before insert.
GEMINI_EMBEDDING_DIMS=768

# --- arXiv -------------------------------------------------------------------
# Terms of use require a contact-identifying UA on automated requests.
ARXIV_USER_AGENT=crosscheck/0.1 (mailto:you@example.com)
# Minimum gap between arXiv requests, ms. ToU floor is 3000. Do not lower.
ARXIV_MIN_REQUEST_INTERVAL_MS=3000

# Free-tier generate_content limit measured at 20 RPM for gemini-3.6-flash
# (2026-09-04, observed in a 429 response). Stay under it.
GEMINI_MAX_RPM=15
GEMINI_EMBED_MAX_RPM=60
